{
  "name": "masar-workspace",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "nuxt dev --port 3000",
    "generate": "nuxt generate",
    "build:app": "nuxt generate && node scripts/install-into-app.mjs",
    "check:app": "node scripts/install-into-app.mjs --check",
    "preview": "npx serve .output/public -s -l 3001",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "e2e": "playwright test --project=chromium",
    "e2e:webkit": "playwright test --project=webkit",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@iconify-json/lucide": "1.2.147",
    "@internationalized/date": "3.12.4",
    "@nuxt/ui": "4.12.0",
    "@tanstack/vue-virtual": "3.13.49",
    "@vueuse/core": "14.4.0",
    "nuxt": "4.6.3",
    "tailwindcss": "4.3.3",
    "vue": "3.5.44",
    "vue-draggable-plus": "0.6.1",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "typescript": "6.0.3",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.13"
  }
}
